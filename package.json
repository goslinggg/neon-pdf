{
  "name": "neon-pdf",
  "version": "2.1.1",
  "description": "Liquid-glass PDF viewer with pen annotations",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.neonpdf.viewer",
    "productName": "Neon PDF",
    "directories": { "output": "release" },
    "files": ["main.js", "index.html", "styles.css", "renderer.js", "build/icon.svg", "node_modules/pdf-lib/**"],
    "extraResources": [{ "from": "node_modules/pdfjs-dist/legacy/build", "to": "pdfjs" }],
    "fileAssociations": [{ "ext": "pdf", "name": "PDF document", "role": "Viewer" }],
    "win": {
      "target": "nsis",
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "displayLanguageSelector": true,
      "installerLanguages": ["ru_RU", "en_US"],
      "language": "1049",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Neon PDF",
      "runAfterFinish": true
    }
  }
}
